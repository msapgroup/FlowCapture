FLOWCAPTURE_ADMIN_USER=admin
FLOWCAPTURE_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
FLOWCAPTURE_SECURE_COOKIES=1

# Optional Gmail sender credentials; use hosting secrets, not a committed file.
FLOWCAPTURE_GMAIL_ADDRESS=
FLOWCAPTURE_GMAIL_APP_PASSWORD=

# Optional customer-owned OpenAI API access; keep the key in hosting secrets.
OPENAI_API_KEY=
FLOWCAPTURE_AI_MODEL=

# QuickBooks Online developer app (customer configures these on the host)
FLOWCAPTURE_QBO_CLIENT_ID=
FLOWCAPTURE_QBO_CLIENT_SECRET=
FLOWCAPTURE_QBO_REDIRECT_URI=
FLOWCAPTURE_QBO_ENCRYPTION_KEY=
FLOWCAPTURE_QBO_ENV=sandbox
